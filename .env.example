# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Client Configuration (Browser & Server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Configuration (Server Side Only - Never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Migration & Performance Flags
ENABLE_DUAL_READ_VERIFICATION=false
CACHE_TTL_STATS_SECONDS=300
CACHE_TTL_PROFILE_SECONDS=30

# Firebase Configuration (Authentication Only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=
FIREBASE_DATABASE_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Drive Storage Integration (Files and Audio Assets Only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
DRIVE_FOLDER_RAW=
DRIVE_FOLDER_QA_REJECTED=
DRIVE_FOLDER_FINAL=
DRIVE_FOLDER_ENGINEERED=
DRIVE_FOLDER_PDF=
DRIVE_FOLDER_BOOKS=
DRIVE_FOLDER_MEDIA=
DRIVE_FOLDER_MEET=

# Optional administrative maintenance scripts
SUPER_ADMIN_EMAIL=
ADMIN_EMAILS=
