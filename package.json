    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "tailwindcss": "^4.1.14",
    "typescript": "5.6.3",
    "vitest": "^5.0.0"
