    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.3.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
