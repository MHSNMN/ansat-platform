    "music-metadata": "^11.15.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.13",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
