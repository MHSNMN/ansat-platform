{
  "name": "ansat-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rimraf dist server-dist server.js",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run --configLoader runner",
    "ci-test": "npm ci && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "admin:grant-super": "tsx scripts/grant-super-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@opentelemetry/api": "^1.9.0",
